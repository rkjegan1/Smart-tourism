# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas Free Tier Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_tourism?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_tourism?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list or * for all)
# Example: http://localhost:5173,https://d123456abcdef8.cloudfront.net
ALLOWED_ORIGINS=*

# Optional Third-Party APIs (for seed/importPlaces.js only)
GEOAPIFY_API_KEY=your_geoapify_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
